{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/test.tsbuildinfo",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "e2e",
    "demo/*.ts",
    "playwright.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.page.json"
    },
    {
      "path": "./tsconfig.worker.json"
    }
  ]
}
